; Tests for FMA16PKPats: a pair of scalar f16 FMAs whose results end up in the
; two halves of one 32-bit value should select a single v_pk_fma_f16.

; The halves are rejoined by a vector build. This is the pattern that fires.
define <2 x half> @fma_build_vector(<2 x half> %a, <2 x half> %b, <2 x half> %c) {
; GFX12-TRUE16-LABEL: fma_build_vector:
; GFX12-TRUE16:       ; %bb.0:
; GFX12-TRUE16-NEXT:    s_wait_loadcnt_dscnt 0x0
; GFX12-TRUE16-NEXT:    s_wait_expcnt 0x0
; GFX12-TRUE16-NEXT:    s_wait_samplecnt 0x0
; GFX12-TRUE16-NEXT:    s_wait_bvhcnt 0x0
; GFX12-TRUE16-NEXT:    s_wait_kmcnt 0x0
; GFX12-TRUE16-NEXT:    v_pk_fma_f16 v0, v0, v1, v2
; GFX12-TRUE16-NEXT:    s_setpc_b64 s[30:31]
  %a.lo = extractelement <2 x half> %a, i32 0
  %a.hi = extractelement <2 x half> %a, i32 1
  %b.lo = extractelement <2 x half> %b, i32 0
  %b.hi = extractelement <2 x half> %b, i32 1
  %c.lo = extractelement <2 x half> %c, i32 0
  %c.hi = extractelement <2 x half> %c, i32 1
  %fma.lo = call half @llvm.fma.f16(half %a.lo, half %b.lo, half %c.lo)
  %fma.hi = call half @llvm.fma.f16(half %a.hi, half %b.hi, half %c.hi)
  %ins.lo = insertelement <2 x half> poison, half %fma.lo, i32 0
  %res = insertelement <2 x half> %ins.lo, half %fma.hi, i32 1
  ret <2 x half> %res
}

; Same computation, but the halves are rejoined by integer bit ops.
define i32 @fma_or_rejoin(i32 %a, i32 %b, i32 %c) {
; GFX12-TRUE16-LABEL: fma_or_rejoin:
; GFX12-TRUE16:       ; %bb.0:
; GFX12-TRUE16-NEXT:    s_wait_loadcnt_dscnt 0x0
; GFX12-TRUE16-NEXT:    s_wait_expcnt 0x0
; GFX12-TRUE16-NEXT:    s_wait_samplecnt 0x0
; GFX12-TRUE16-NEXT:    s_wait_bvhcnt 0x0
; GFX12-TRUE16-NEXT:    s_wait_kmcnt 0x0
; GFX12-TRUE16-NEXT:    v_pk_fma_f16 v0, v0, v1, v2
; GFX12-TRUE16-NEXT:    s_setpc_b64 s[30:31]
  %a.lo.i = trunc i32 %a to i16
  %a.lo = bitcast i16 %a.lo.i to half
  %a.sh = lshr i32 %a, 16
  %a.hi.i = trunc i32 %a.sh to i16
  %a.hi = bitcast i16 %a.hi.i to half
  %b.lo.i = trunc i32 %b to i16
  %b.lo = bitcast i16 %b.lo.i to half
  %b.sh = lshr i32 %b, 16
  %b.hi.i = trunc i32 %b.sh to i16
  %b.hi = bitcast i16 %b.hi.i to half
  %c.lo.i = trunc i32 %c to i16
  %c.lo = bitcast i16 %c.lo.i to half
  %c.sh = lshr i32 %c, 16
  %c.hi.i = trunc i32 %c.sh to i16
  %c.hi = bitcast i16 %c.hi.i to half
  %fma.lo = call half @llvm.fma.f16(half %a.lo, half %b.lo, half %c.lo)
  %fma.hi = call half @llvm.fma.f16(half %a.hi, half %b.hi, half %c.hi)
  %lo.i = bitcast half %fma.lo to i16
  %lo = zext i16 %lo.i to i32
  %hi.i = bitcast half %fma.hi to i16
  %hi.z = zext i16 %hi.i to i32
  %hi = shl nuw i32 %hi.z, 16
  %res = or disjoint i32 %hi, %lo
  ret i32 %res
}

